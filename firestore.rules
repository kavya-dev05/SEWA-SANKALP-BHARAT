rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ────────────────────────────────────────────────────

    // True if the request is from a signed-in Firebase Auth user.
    function isSignedIn() {
      return request.auth != null;
    }

    // True if the signed-in user's UID matches the given uid.
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // True if the signed-in user's document exists in Firestore.
    // Using exists() before get() prevents errors for new users who have no
    // profile document yet.
    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // True if the signed-in user has isAdmin == true in their profile.
    // .get('isAdmin', false) returns false when the field is absent, so this
    // is null-safe and never throws even if the doc is missing a field.
    function isAdmin() {
      return isSignedIn()
        && userDocExists()
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.get('isAdmin', false) == true;
    }

    // ─── Users ───────────────────────────────────────────────────────────────
    // • Users can read and write (create/update) their own profile.
    // • Admins can read and update any profile.
    // • Nobody (not even the user) can delete their own account document;
    //   deletions go through the Admin SDK on the server.
    // Note: ALL other server-side writes use Firebase Admin SDK which bypasses
    // these rules entirely — only the client SDK is restricted here.
    match /users/{userId} {
      allow get:    if isOwner(userId) || isAdmin();
      allow list:   if isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if false;
    }

    // ─── Donations ───────────────────────────────────────────────────────────
    // Donors can read their own donations and create new ones.
    // Server (Admin SDK) handles all updates and deletes.
    match /donations/{donationId} {
      allow get:    if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list:   if isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ─── NGOs (publicly readable by any signed-in user) ──────────────────────
    // All NGO data is seeded and managed by the server via Admin SDK.
    match /ngos/{ngoId} {
      allow read:  if isSignedIn();
      allow write: if false;
    }

    // ─── Volunteer Opportunities (publicly readable) ──────────────────────────
    match /volunteer_opportunities/{oppId} {
      allow read:  if isSignedIn();
      allow write: if false;
    }

    // ─── Volunteer Engagements ───────────────────────────────────────────────
    // A user can read/create their own engagements.
    match /volunteer_engagements/{engId} {
      allow get:    if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list:   if isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ─── NGO Needs (publicly readable) ───────────────────────────────────────
    match /ngo_needs/{needId} {
      allow read:  if isSignedIn();
      allow write: if false;
    }

    // ─── Beneficiary Requests ────────────────────────────────────────────────
    match /beneficiary_requests/{reqId} {
      allow get:    if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list:   if isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ─── Notifications ───────────────────────────────────────────────────────
    // NGO users can read their own notifications; server writes them.
    match /notifications/{notifId} {
      allow get:    if isSignedIn() && resource.data.ngoUserId == request.auth.uid;
      allow list:   if isSignedIn() && resource.data.ngoUserId == request.auth.uid;
      allow write:  if false;
    }
  }
}
